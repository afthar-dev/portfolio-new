# Make (Integromat) webhook that receives contact form submissions.
# Create a scenario with a "Custom webhook" trigger and paste its URL here.
# Server-side only — deliberately not NEXT_PUBLIC, so it never reaches the browser.
MAKE_WEBHOOK_URL=

# Live origin, no trailing slash. Canonical URLs, Open Graph tags, the sitemap
# and robots.txt are all built from this, so it must match the deployed domain.
NEXT_PUBLIC_SITE_URL=https://afthar.site
